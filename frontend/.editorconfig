##
## Frontend indentation.
##
## This stack is complete on its own, so it carries its own settings rather than
## depending on the file at the top of the repository.
##
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,svelte,css,html}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[*.{json}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
