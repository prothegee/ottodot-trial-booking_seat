##
## directory: dependencies and build output
##
## Anchored to this stack, so they catch frontend/build and never a source
## directory that happens to be called build.
##
/node_modules
/.svelte-kit
/build
/.vite

##
## directory: source that a broader rule would otherwise swallow
##
## The repository root ignores bare directory names at any depth: cache, build,
## data, out, log, logs, tmp, dist, bin, and target. Those are aimed at build
## output, and a source directory is free to carry any of them. `src/lib/cache`
## was the first one this caught, and naming it alone left the next one waiting.
##
## The source trees are put back below. The patterns end in a slash so they
## match directories only, which is exactly what is needed: a directory has to
## be re-included before git will look inside it at all, and leaving files alone
## keeps the tooling state below still ignored.
##
## A rule in this file wins over the root one for every path under this stack.
##
!/src/**/
!/containers/**/
!/scripts/**/

##
## file: tooling state
##
*.tsbuildinfo
vite.config.ts.timestamp-*
npm-debug.log*

##
## file: local environment
##
## The template is committed and the real file is not. The exception has to be
## spelled out, because .env.* would otherwise take the template with it.
##
.env
.env.*
!.env.template
