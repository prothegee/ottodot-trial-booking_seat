# ---------------------------------------------------------------------------- #
# Caddy serves the static bundle on 9001.
#
# try_files is what makes client routing work. A parent who reloads on
# /book/some-id must get the same document as a parent who arrived there by
# clicking, because no server here knows what a class id is.
#
# There is no reverse proxy to the api. The client calls 9000 directly and sends
# its real origin, which is what the api checks on every mutation. Proxying
# would hide that origin and quietly disable the check.
# ---------------------------------------------------------------------------- #

{
    admin off
    auto_https off
}

:9001 {
    root * /srv
    encode zstd gzip

    try_files {path} /index.html
    file_server

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }

    # Hashed asset names never change contents, so they can be cached hard. The
    # entry document must not be, or a parent keeps loading yesterday's bundle.
    @immutable path /_app/immutable/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @document path / /index.html
    header @document Cache-Control "no-cache"

    log {
        output stdout
        format console
    }
}
