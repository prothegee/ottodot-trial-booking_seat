# ---------------------------------------------------------------------------- #
# The frontend image: build the static bundle, then serve it with nginx.
#
# Build context is the frontend directory:
#   docker build -f containers/Containerfile -t ottodot-frontend ./frontend
#
# The api address and the build identity are build arguments, not runtime
# settings, because the bundle is static and the values are compiled into it.
# A different backend means a different image, which is the honest shape.
# ---------------------------------------------------------------------------- #

FROM docker.io/library/node:24-alpine AS build

WORKDIR /src

# The lock file is copied first, so an edit to a component does not reinstall
# every package.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# The identity arguments are empty by default on purpose. An empty value is read
# as unset, so the build falls back to the version package.json declares. The
# commit cannot be found this way, because a build context has no git history in
# it, which is why a pipeline hands that one in.
ARG API_BASE_URL=http://127.0.0.1:9000
ARG BUILD_VERSION=
ARG BUILD_COMMIT=

ENV API_BASE_URL=${API_BASE_URL}
ENV BUILD_VERSION=${BUILD_VERSION}
ENV BUILD_COMMIT=${BUILD_COMMIT}

RUN npm run build

FROM docker.io/library/nginx:stable-alpine

# Over the default server block, not beside it, so the image's own example page
# is not left answering on another path.
COPY containers/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build /usr/share/nginx/html

EXPOSE 9001

# The image already starts nginx in the foreground, so no command is given here.
