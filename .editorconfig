##
## Repository wide defaults.
##
## Each stack carries its own .editorconfig as well, because either half can be
## split out and still open correctly on its own. This file is what covers the
## parts that belong to neither: the shared scripts, the root documents, and any
## editor opened at the top of the tree.
##
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

##
## Makefile: tabs are the syntax, not a preference.
##
[Makefile]
indent_style = tab

##
## Two-space families, matching what is already written.
##
[*.{yml,yaml,json}]
indent_size = 2

##
## Markdown is left at the common width and keeps its trailing spaces, because
## two of them at the end of a line is a line break rather than an accident.
##
[*.md]
trim_trailing_whitespace = false
