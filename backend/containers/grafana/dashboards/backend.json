        {
            "id": 19,
            "type": "row",
            "title": "Transaction failures",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 36
            },
            "panels": [],
            "description": "A rollback is not automatically a fault. A confirm that loses the race rolls back by design, which is why confirm outcomes are split three ways and only error means something broke."
        },
        {
            "id": 20,
            "type": "timeseries",
            "title": "Confirm outcomes",
            "description": "confirmed, seat_lost, and error. The middle one is correct behaviour and the last one is not, and no alert could tell them apart if they shared a series.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 37
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (outcome) (rate(confirm_transaction_total[5m]))",
                    "legendFormat": "{{outcome}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 21,
            "type": "timeseries",
            "title": "Confirm errors",
            "description": "The exact series TransactionErrorSpike fires on, queried by name, so the alert and the panel cannot drift apart.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 37
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "increase(confirm_transaction_total{outcome=\"error\"}[5m])",
                    "legendFormat": "broken",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 22,
            "type": "stat",
            "title": "Refunds owed",
            "description": "Parents who have been charged and not yet refunded. The only number on this dashboard where the cost of ignoring it is somebody's money.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 37
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "refund_pending_bookings",
                    "legendFormat": "pending",
                    "datasource": {
