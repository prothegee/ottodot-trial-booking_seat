{
    "uid": "ottodot-backend",
    "title": "Ottodot backend",
    "description": "The Go api and worker: resources first, then the two failure groups the brief calls out, then traffic, bookings, and the infrastructure underneath.",
    "tags": [
        "ottodot",
        "backend"
    ],
    "timezone": "browser",
    "editable": false,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s",
            "1m",
            "5m"
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Fault injection",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "panels": [],
            "description": "Reads one while this stack can be broken on purpose. It is the first row so nobody mistakes a deliberately broken demonstration for a healthy service."
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Fault injection enabled",
            "description": "One while the development only injection surface is live. It is published even when the surface is off, so the panel says zero rather than nothing at all.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "fault_injection_enabled",
                    "legendFormat": "armed",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Faults triggered",
            "description": "Faults that actually fired, by point. Anything here was arranged on purpose, which is what tells an arranged failure apart from a real one.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 16,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "increase(fault_injected_total[5m])",
                    "legendFormat": "{{point}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 4,
            "type": "row",
            "title": "Resources",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "panels": [],
            "description": "Layer one is what each process knows about itself and layer two is what the host knows. Neither needs cAdvisor, so this row still draws when the container runtime socket is not available."
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Process cpu",
            "description": "Cpu burned by each Go process, from the process collector. Layer one, so it needs nothing beyond the binaries themselves.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(process_cpu_seconds_total{job=\"api\"}[5m])",
                    "legendFormat": "api",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "rate(process_cpu_seconds_total{job=\"worker\"}[5m])",
                    "legendFormat": "worker",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Process memory",
            "description": "Resident memory per process, with the heap alongside it. A resident number that grows while the heap is flat is something outside Go holding memory.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 6
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "process_resident_memory_bytes{job=\"api\"}",
                    "legendFormat": "api",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "process_resident_memory_bytes{job=\"worker\"}",
                    "legendFormat": "worker",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "C",
                    "expr": "go_memstats_heap_inuse_bytes{job=\"api\"}",
                    "legendFormat": "api heap",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Host drive free",
            "description": "Drive space and inodes left per mount, from node_exporter. Postgres fills a volume long before anything else in this stack does, and inodes are the failure nobody predicts.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}",
                    "legendFormat": "{{mountpoint}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "node_filesystem_files_free{fstype!~\"tmpfs|overlay\"}",
                    "legendFormat": "{{mountpoint}} inodes",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Host cpu",
            "description": "Derived from idle rather than from a busy metric, so it stays correct however many cores the host has.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 13
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
                    "legendFormat": "used",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Host memory available",
            "description": "Available rather than free, because free excludes cache the kernel would give back. The load average is here for context on the same time range.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 13
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "node_memory_MemAvailable_bytes",
                    "legendFormat": "available",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "node_load1",
                    "legendFormat": "load 1m",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Goroutines and pauses",
            "description": "A goroutine floor that rises and never comes back down is a leak. Garbage collection time is here because it is the first thing to move when the heap is under pressure.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 13
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "go_goroutines{job=\"api\"}",
                    "legendFormat": "api goroutines",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "go_goroutines{job=\"worker\"}",
                    "legendFormat": "worker goroutines",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "C",
                    "expr": "rate(go_gc_duration_seconds_sum[5m])",
                    "legendFormat": "gc time",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 11,
            "type": "row",
            "title": "Containers",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 20
            },
            "panels": [],
            "description": "Layer three, from cAdvisor. This is the row that goes blank when the container runtime socket is not available, and the two rows above are what still answer cpu, memory, and drive when it does."
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "Container cpu",
            "description": "Cpu per container: api, worker, both databases, and Redis.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 21
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(container_cpu_usage_seconds_total{name=~\"ottodot-.+\"}[5m])",
                    "legendFormat": "{{name}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "Container memory",
            "description": "Working set per container, which is the number that gets a container killed.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 21
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "container_memory_working_set_bytes{name=~\"ottodot-.+\"}",
                    "legendFormat": "{{name}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 14,
            "type": "timeseries",
            "title": "Container drive and restarts",
            "description": "Drive used per container is how a filling Postgres volume becomes visible. Restarts are here because a crash loop is invisible in application metrics.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 21
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "container_fs_usage_bytes{name=~\"ottodot-.+\"}",
                    "legendFormat": "{{name}} used",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "changes(container_start_time_seconds{name=~\"ottodot-.+\"}[10m])",
                    "legendFormat": "{{name}} restarts",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 15,
            "type": "row",
            "title": "Access failures",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 28
            },
            "panels": [],
            "description": "Called out in the brief as important, so they get a row rather than being buried in a status code chart."
        },
        {
            "id": 16,
            "type": "timeseries",
            "title": "Denials by reason",
            "description": "The reason label is what tells a broken client apart from a batch of sessions timing out and from somebody trying accounts one at a time.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 29
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (reason) (rate(access_denied_total[5m]))",
                    "legendFormat": "{{reason}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 17,
            "type": "timeseries",
            "title": "Rate limit and bot checks",
            "description": "Which bucket ran dry, and which cooperative check caught a submission. The caller is never told either of these.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 29
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (scope) (rate(rate_limit_rejected_total[5m]))",
                    "legendFormat": "limit {{scope}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "sum by (check) (rate(bot_check_rejected_total[5m]))",
                    "legendFormat": "bot {{check}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {}
        },
        {
            "id": 18,
            "type": "timeseries",
            "title": "Sessions",
            "description": "Refresh reuse is the one number here that always deserves a person. It is either a stolen token or a client bug, and both want a look.",
            "datasource": {
                "type": "prometheus",
                "uid": "ottodot-prometheus"
            },
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 29
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "increase(auth_refresh_reuse_detected_total[5m])",
                    "legendFormat": "refresh reuse",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "sum by (kind) (rate(auth_token_issued_total[5m]))",
                    "legendFormat": "issued {{kind}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "ottodot-prometheus"
                    }
                },
                {
                    "refId": "C",
                    "expr": "rate(auth_login_refused_total[5m])",
                    "legendFormat": "sign in refused",
                    "datasource": {
