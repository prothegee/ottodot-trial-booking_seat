# ---------------------------------------------------------------------------- #
# The api binary, port 9000.
#
# Build context is the backend directory:
#   docker build -f containers/Containerfile.api -t ottodot-api ./backend
#
# Two stages so the shipped image carries the binary and nothing else. No shell,
# no package manager, no source.
# ---------------------------------------------------------------------------- #

FROM docker.io/library/golang:1.26-alpine AS build

WORKDIR /src

# Dependencies resolve before the source is copied, so an edit to a Go file does
# not re-download the module cache.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# All three default to empty, and empty is how the binary says it was not
# stamped. The build context is a copy of the source without the repository, so
# nothing in here can work a commit out on its own: what is not handed in is
# answered by the process at startup, from its configuration and from its own
# file, and reported as unknown when no source could name it.
ARG BUILD_VERSION=
ARG BUILD_COMMIT=
ARG BUILD_TIME=

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X main.buildVersion=${BUILD_VERSION} -X main.buildCommit=${BUILD_COMMIT} -X main.buildTime=${BUILD_TIME}" \
    -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/api /api

EXPOSE 9000
USER nonroot:nonroot

ENTRYPOINT ["/api"]
