# ---------------------------------------------------------------------------- #
# The worker binary. It has no public surface, only a metrics listener on 9002.
#
# Build context is the backend directory:
#   docker build -f containers/Containerfile.worker -t ottodot-worker ./backend
#
# Separate image from the api on purpose: the worker has to survive an api
# restart, which it cannot do while sharing a process with it.
# ---------------------------------------------------------------------------- #

FROM docker.io/library/golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Both default to empty, and empty is how the binary says it was not stamped.
# The build context is a copy of the source without the repository, so what is
# not handed in is answered by the process at startup from its configuration.
ARG BUILD_VERSION=
ARG BUILD_COMMIT=

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X main.buildVersion=${BUILD_VERSION} -X main.buildCommit=${BUILD_COMMIT}" \
    -o /out/worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/worker /worker

EXPOSE 9002
USER nonroot:nonroot

ENTRYPOINT ["/worker"]
